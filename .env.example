# Copy this file to `.env` and fill in what you have. Never commit `.env`.

# ---- Claude (writes and tailors resumes) ----
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
KY_MODEL=claude-sonnet-5-5

# ---- Job search sources (all free; add whichever you sign up for) ----
# Adzuna: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJOBS (VA hospitals, federal jobs): https://developer.usajobs.gov
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=

# ---- Daily digest by email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail, use an App Password (Google Account > Security > App passwords)
SMTP_PASSWORD=
DIGEST_TO=

# ---- Optional: instant alerts to Discord or Slack ----
WEBHOOK_URL=
